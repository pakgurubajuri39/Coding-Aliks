rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidStudent(data) {
      return (!('studentName' in data) || (data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 200))
        && (!('competitionIdea' in data) || (data.competitionIdea is string && data.competitionIdea.size() > 0 && data.competitionIdea.size() <= 3000));
    }

    // Test connection check
    match /test/{docId} {
      allow read, write: if true;
    }

    // Students collection for Erlass Coding Competition 2026
    match /students/{studentId} {
      // Allow all users to read/search student competition projects in real time
      allow read: if true;

      // Allow creating, updating, and deleting student competition entries
      allow create: if isValidId(studentId) 
        && incoming().studentName is string 
        && incoming().studentName.size() > 0 
        && isValidStudent(incoming());

      allow update: if isValidId(studentId) && isValidStudent(incoming());

      allow delete: if isValidId(studentId);
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
